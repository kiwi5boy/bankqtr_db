# Cached EDGAR payloads: large, regenerable, and not ours to redistribute.
data/raw/
data/out/
# Downloaded IR supplements and earnings decks -- same reasoning, and ~1.6 GB
# of it.  Rebuild with scripts/fetch_ir.py.
data/ir/

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.tmp

# The Pages artifact's copy of the published panels.  The originals live in
# data/ and are committed; the workflow stages them under docs/ so the site's
# download links resolve relative to the page.  Committing both would put the
# same 16 MB in the repository twice.
docs/data/

# The example notebook's local cache of the release assets. Downloaded on first
# run by examples/peer_nco_benchmark.ipynb; regenerable, and the same files as
# data/out/.  Unanchored, because the cache lands beside whatever directory the
# notebook's kernel was started in.
_data/

# marimo's per-notebook session cache. Written beside the notebook whenever
# it is opened, holds the last run's cell outputs, and is not part of it.
__marimo__/

# The explorer's WASM bundle, where scripts/export_explorer.py puts it by
# default. It is ~30 MB of marimo runtime plus a copy of both panels, all of
# it regenerable from one command, and none of it reviewable in a diff.
/build/

# Scratch extraction grids from analysis runs. Every parquet a build produces
# lands under data/; one at the repository root is an accident.
/*.parquet
